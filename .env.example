# EmailJS (stávající)
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Firebase Auth
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Admin API
# Autorizace jde přes Firebase ID token přihlášeného uživatele
# (viz src/utils/adminApi.js + server/api/firebase_auth.php),
# žádný sdílený API klíč už není potřeba.
# URL k PHP API (v produkci relativní, lokálně plná URL)
REACT_APP_ADMIN_API_URL=https://www.arapro.cz/server/api
